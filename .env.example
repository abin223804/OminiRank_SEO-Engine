# MongoDB connection string (MongoDB Atlas or Local MongoDB Replica Set)
# Example Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/omnirank?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/omnirank
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/omnirank?retryWrites=true&w=majority"

# AES-256-GCM 32-byte secret encryption key (64 hex characters)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Authentication (Supabase Auth / Google OAuth / SAML 2.0 SSO)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Development Auth Mock User ID (used when running locally in development mode)
DEV_AUTH_USER_ID="dev_user_omnirank_01"
DEV_AUTH_USER_EMAIL="architect@tekora.internal"
DEV_AUTH_USER_NAME="Staff Architect"

# Google Search Console OAuth2 credentials (used in Phase 2)
GSC_CLIENT_ID=""
GSC_CLIENT_SECRET=""
GSC_REDIRECT_URI="http://localhost:3000/api/v1/auth/gsc/callback"

# AI Model Gateway (Phase 3)
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# Stripe Billing (Phase 4)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_STARTER_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""
STRIPE_AGENCY_PRICE_ID=""

# Resend Email (Phase 5)
RESEND_API_KEY=""
ALERT_EMAIL_SENDER="OmniRank Radar <radar@omnirank.io>"
